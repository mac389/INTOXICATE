fmt_p_inline <- function(p) {
  if (is.na(p)) return("NA")
  if (p < 0.001) return("p < 0.001")
  paste0("p = ", format(round(p, 3), nsmall = 3))
}

# Wilson score CI — returns named vector c(est, lo, hi)
wilson_ci <- function(x, n, conf = 0.95) {
  if (n == 0) return(c(est = 0, lo = 0, hi = 0))
  z <- qnorm(1 - (1 - conf) / 2)
  p <- x / n
  denom  <- 1 + z^2 / n
  center <- (p + z^2 / (2 * n)) / denom
  spread <- z * sqrt((p * (1 - p) + z^2 / (4 * n)) / n) / denom
  c(est = p,
    lo  = max(0, center - spread),
    hi  = min(1, center + spread))
}

# Cohen's kappa — always returns a plain list, never errors
compute_kappa <- function(pred, actual) {
  # Point estimate via contingency table (no external package needed)
  tab <- table(factor(pred, levels = c(0, 1)),
               factor(actual, levels = c(0, 1)))
  n  <- sum(tab)
  po <- sum(diag(tab)) / n
  pe <- sum(rowSums(tab) * colSums(tab)) / n^2
  k  <- if (pe == 1) NA_real_ else (po - pe) / (1 - pe)

  # CI via psych if installed, otherwise NA
  lo <- NA_real_; hi <- NA_real_
  if (requireNamespace("psych", quietly = TRUE) && !is.na(k)) {
    tryCatch({
      kk <- psych::cohen.kappa(cbind(pred, actual))
      lo <- kk$confid["unweighted kappa", "lower"]
      hi <- kk$confid["unweighted kappa", "upper"]
    }, error = function(e) NULL)
  }
  list(kappa = k, lo = lo, hi = hi)
}

# Format a metric with optional CI
fmt_metric <- function(est, lo, hi, pct = FALSE) {
  scale <- if (pct) 100 else 1
  fmt   <- if (pct) "%.0f%%" else "%.2f"
  if (is.na(lo) || is.na(hi)) {
    sprintf(fmt, est * scale)
  } else {
    sprintf(paste0(fmt, " (", fmt, "\u2013", fmt, ")"),
            est * scale, lo * scale, hi * scale)
  }
}
