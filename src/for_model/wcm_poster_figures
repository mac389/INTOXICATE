\noindent\textbf{\large Model Comparison: IRS With vs. Without Biological Sex}

\noindent\textit{Two logistic regression models fit on the same complete-case data. All predictors match the supervisor-specified model. Biological sex is added directly as a covariate in the second model.}

\vspace{6pt}

```{r model_fit, results='asis'}
model_wo_sex <- glm(
  `Dichotomous Outcome` ~ Pulse + SBP + GCS + Age +
    `Respiratory Insufficiency` + Cirrhosis +
    `Secondary Reason for ICU Admission` + Dysrhythmia +
    `Exposure Category`,
  data = model_data, family = binomial
)

model_w_sex <- glm(
  `Dichotomous Outcome` ~ Gender + Pulse + SBP + GCS + Age +
    `Respiratory Insufficiency` + Cirrhosis +
    `Secondary Reason for ICU Admission` + Dysrhythmia +
    `Exposure Category`,
  data = model_data, family = binomial
)

# Helper: clean coefficient table from a glm object
coef_table <- function(fit) {
  s <- summary(fit)$coefficients
  df <- data.frame(
    Variable    = rownames(s),
    Coefficient = round(s[, "Estimate"], 4),
    SE          = round(s[, "Std. Error"], 4),
    `z-value`   = round(s[, "z value"], 4),
    `p-value`   = ifelse(s[, "Pr(>|z|)"] < 0.001, "< 0.001",
                          sprintf("%.4f", s[, "Pr(>|z|)"])),
    check.names = FALSE
  )
  rownames(df) <- NULL
  df
}

cat("\\textbf{Model without sex:}\\vspace{4pt}\n\n")
kbl(coef_table(model_wo_sex), booktabs = TRUE,
    align = c("l","r","r","r","r")) %>%
  kable_styling(latex_options = c("hold_position", "scale_down"),
                full_width = FALSE, position = "left") %>%
  print()
cat("\n\n")

cat("\\textbf{Model with sex:}\\vspace{4pt}\n\n")
kbl(coef_table(model_w_sex), booktabs = TRUE,
    align = c("l","r","r","r","r")) %>%
  kable_styling(latex_options = c("hold_position", "scale_down"),
                full_width = FALSE, position = "left") %>%
  print()
cat("\n\n")

# Likelihood ratio test
lrt    <- anova(model_wo_sex, model_w_sex, test = "LRT")
lrt_p  <- lrt[2, "Pr(>Chi)"]
lrt_x2 <- lrt[2, "Deviance"]
lrt_df <- lrt[2, "Df"]

lrt_df_out <- data.frame(
  `Chi-squared` = round(lrt_x2, 3),
  df            = lrt_df,
  `p-value`     = ifelse(lrt_p < 0.001, "< 0.001",
                          sprintf("%.3f", lrt_p)),
  Significant   = ifelse(lrt_p < 0.05, "Yes", "No"),
  check.names   = FALSE
)

cat("\\textbf{Likelihood ratio test (with sex vs. without):}\\vspace{4pt}\n\n")
kbl(lrt_df_out, booktabs = TRUE, align = c("r","r","r","c")) %>%
  kable_styling(latex_options = "hold_position",
                full_width = FALSE, position = "left") %>%
  print()
cat("\n\n")
