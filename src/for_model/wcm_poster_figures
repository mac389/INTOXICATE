                                       levels = rev(cat_order)))

x_max <- max(fig2_data$n) * 1.10
chi_label <- sprintf("Sex \u00d7 Exposure Category: %s", fmt_p_inline(chi_p))

fig2 <- ggplot(fig2_data,
               aes(x = n, y = `Exposure Category`, fill = Sex)) +
  geom_col(position = position_dodge(width = 0.78), width = 0.7, color = NA) +
  geom_text(aes(label = n),
            position = position_dodge(width = 0.78),
            hjust = -0.35, size = 3.6, color = INK) +
  annotate("label",
           x = x_max * 0.98, y = length(cat_order) / 2 + 0.5,
           label = chi_label,
           hjust = 1, size = 3.8, color = INK,
           label.size = 0.3, label.r = unit(2, "pt"), fill = "#F5F5F5") +
  scale_fill_manual(values = c("Female" = FEMALE_COLOR, "Male" = MALE_COLOR),
                    name = NULL) +
  scale_x_continuous(expand = expansion(mult = c(0, 0.02)),
                     limits = c(0, x_max),
                     breaks = pretty(c(0, x_max))) +
  scale_y_discrete(expand = expansion(add = c(0.6, 2.2))) +
  labs(title = "Figure 2. Exposure Category Counts by Biological Sex",
       x = "Number of Patients", y = NULL) +
  theme_clean(base_size = 12) +
  theme(
    plot.title      = element_text(face = "bold", size = 13, color = INK,
                                   margin = margin(b = 10)),
    legend.position = c(0.82, 0.92),
    legend.background = element_rect(fill = "white", color = NA),
    axis.text.y     = element_text(size = 12, color = INK)
  )

print(fig2)
save_png(fig2, "fig2_exposure_by_sex.png", width = 8.5, height = 5.5)
