# Key Results for Abstract {-}

```{r key_results, results='asis'}
# ============================================================================
# 1. DEMOGRAPHICS
# ============================================================================
model_data <- clean_data %>% filter(!is.na(`INTOXICATE SCORE`), !is.na(`Dichotomous Outcome`))
train_data <- model_data %>% filter(dataset == "original")
test_data <- model_data %>% filter(dataset == "accrued")

demo_line <- function(data, label) {
  n <- nrow(data)
  f <- data %>% filter(Gender == "F")
  m <- data %>% filter(Gender == "M")
  icu <- sum(data$`Dichotomous Outcome`)
  sprintf("**%s (n=%d):** %d females (%d%%), median age %.0f [IQR %.0f--%.0f]; %d males (%d%%), median age %.0f [IQR %.0f--%.0f]; %d ICU admissions (%d%%)",
    label, n,
    nrow(f), round(100*nrow(f)/n), median(f$Age), quantile(f$Age,.25), quantile(f$Age,.75),
    nrow(m), round(100*nrow(m)/n), median(m$Age), quantile(m$Age,.25), quantile(m$Age,.75),
    icu, round(100*icu/n))
}

cat("## 1. Demographics (modeling subset)\n\n")
cat(demo_line(train_data, "Original external validation set"), "\n\n")
cat(demo_line(model_data, "Larger data set"), "\n\n")

# ============================================================================
# 2. SEX-EXPOSURE ASSOCIATION
# ============================================================================
cat("## 2. Sex-Exposure Association\n\n")

# Overall chi-square
cont_table <- table(clean_data$`Exposure Category`, clean_data$Gender)
chi_result <- suppressWarnings(chisq.test(cont_table))
cat(sprintf("**Overall chi-squared test: p = %s**\n\n", format_p(chi_result$p.value)))

# Key categories
for (exp_cat in c("Antidepressants", "Sedatives", "Analgesic", "Street Drugs", "CO, As, CN")) {
  e <- clean_data %>% filter(`Exposure Category` == exp_cat) %>% count(Gender) %>% mutate(pct = round(100*n/sum(n)))
  f_row <- e %>% filter(Gender == "F")
  m_row <- e %>% filter(Gender == "M")
  cat(sprintf("- %s: %d%% female, %d%% male\n", exp_cat, f_row$pct, m_row$pct))
}

# ============================================================================
# 3. MODEL PERFORMANCE
# ============================================================================
cat("\n## 3. Model Performance\n\n")

# Fit on training
model_base <- glm(`Dichotomous Outcome` ~ `INTOXICATE SCORE`, data = train_data, family = binomial)
model_sex <- glm(`Dichotomous Outcome` ~ `INTOXICATE SCORE` + Gender, data = train_data, family = binomial)

# Test set performance
calc_metrics <- function(pred, actual, thresh = 0.5) {
  pc <- ifelse(pred >= thresh, 1, 0)
  TP <- sum(pc==1 & actual==1); TN <- sum(pc==0 & actual==0)
  FP <- sum(pc==1 & actual==0); FN <- sum(pc==0 & actual==1)
  list(sens = TP/(TP+FN), spec = TN/(TN+FP))
}

pred_test_base <- predict(model_base, newdata = test_data, type = "response")
pred_test_sex <- predict(model_sex, newdata = test_data, type = "response")
actual_test <- test_data$`Dichotomous Outcome`

m_base <- calc_metrics(pred_test_base, actual_test)
m_sex <- calc_metrics(pred_test_sex, actual_test)

cat(sprintf("**Original validation set → tested on accrued cases (n=%d):**\n\n", nrow(test_data)))
cat(sprintf("| | Sensitivity | Specificity |\n"))
cat(sprintf("|---|---|---|\n"))
cat(sprintf("| Without sex | %.3f | %.3f |\n", m_base$sens, m_base$spec))
cat(sprintf("| With sex | %.3f | %.3f |\n", m_sex$sens, m_sex$spec))

# Combined in-sample
model_all_base <- glm(`Dichotomous Outcome` ~ `INTOXICATE SCORE`, data = model_data, family = binomial)
model_all_sex <- glm(`Dichotomous Outcome` ~ `INTOXICATE SCORE` + Gender, data = model_data, family = binomial)
pred_all_base <- predict(model_all_base, type = "response")
pred_all_sex <- predict(model_all_sex, type = "response")
actual_all <- model_data$`Dichotomous Outcome`
m_all_base <- calc_metrics(pred_all_base, actual_all)
m_all_sex <- calc_metrics(pred_all_sex, actual_all)

cat(sprintf("\n**Larger data set (n=%d, in-sample):**\n\n", nrow(model_data)))
cat(sprintf("| | Sensitivity | Specificity |\n"))
cat(sprintf("|---|---|---|\n"))
cat(sprintf("| Without sex | %.3f | %.3f |\n", m_all_base$sens, m_all_base$spec))
cat(sprintf("| With sex | %.3f | %.3f |\n", m_all_sex$sens, m_all_sex$spec))
