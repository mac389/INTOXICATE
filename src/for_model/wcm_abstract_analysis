```{r full_model_output}
cat("=== TRAINING: Model WITH sex (original dataset) ===\n")
print(summary(model_sex))

ci_sex <- confint(model_sex)
sex_coef <- coef(summary(model_sex))["GenderM", ]
cat(sprintf("\nSex coefficient: %.3f (95%% CI: %.3f to %.3f), p=%s\n",
  sex_coef["Estimate"], ci_sex["GenderM", 1], ci_sex["GenderM", 2],
  format_p(sex_coef["Pr(>|z|)"])))

lrt <- anova(model_base, model_sex, test = "Chisq")
cat(sprintf("LRT p-value: %s\n", format_p(lrt$`Pr(>Chi)`[2])))

cat("\n=== TRAINING: Model WITH sex (combined dataset) ===\n")
print(summary(model_all_sex))

ci_all <- confint(model_all_sex)
sex_coef_all <- coef(summary(model_all_sex))["GenderM", ]
cat(sprintf("\nSex coefficient: %.3f (95%% CI: %.3f to %.3f), p=%s\n",
  sex_coef_all["Estimate"], ci_all["GenderM", 1], ci_all["GenderM", 2],
  format_p(sex_coef_all["Pr(>|z|)"])))

# AUC for reference
roc_test_base <- roc(actual_test, pred_test_base, quiet = TRUE)
roc_test_sex <- roc(actual_test, pred_test_sex, quiet = TRUE)
roc_all_base <- roc(actual_all, pred_all_base, quiet = TRUE)
roc_all_sex <- roc(actual_all, pred_all_sex, quiet = TRUE)

cat(sprintf("\n=== AUC (for reference) ===\n"))
cat(sprintf("Test set:  without sex %.3f, with sex %.3f\n", auc(roc_test_base), auc(roc_test_sex)))
cat(sprintf("Combined:  without sex %.3f, with sex %.3f\n", auc(roc_all_base), auc(roc_all_sex)))
