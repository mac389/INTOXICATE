            top_kappa$kappa,
            sweep_results$kappa[sweep_results$male_adj == 0 &
                                  sweep_results$female_adj == 0],
            sweep_results$kappa[sweep_results$male_adj == 3 &
                                  sweep_results$female_adj == 0]))

# Apply the optimal adjustment and identify changed patients
