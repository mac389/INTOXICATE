\vspace{6pt}

\noindent\textbf{\large Baseline IRS Accuracy by Sex (No Adjustment)}

\noindent\textit{Before any sex adjustment, how does the unmodified IRS perform separately for male and female patients? If accuracy is symmetric, sex doesn't add information. If accuracy differs, that's the direct evidence for sex-specific recalibration.}

\vspace{6pt}

```{r baseline_by_sex, results='asis'}
# ============================================================================
# BASELINE IRS PERFORMANCE BY SEX
# Compute sensitivity, specificity, accuracy, and confusion matrix for the
# unmodified IRS (threshold > 6) separately for male and female patients.
# ============================================================================

library(knitr)
library(kableExtra)

baseline_by_sex <- model_data %>%
  mutate(
    pred_baseline = ifelse(`INTOXICATE SCORE` > 6, 1, 0),
    correct = pred_baseline == `Dichotomous Outcome`
  ) %>%
  group_by(Gender) %>%
  summarise(
    n_total       = n(),
    n_icu_actual  = sum(`Dichotomous Outcome` == 1),
    n_non_actual  = sum(`Dichotomous Outcome` == 0),
    tp = sum(pred_baseline == 1 & `Dichotomous Outcome` == 1),
    fp = sum(pred_baseline == 1 & `Dichotomous Outcome` == 0),
    tn = sum(pred_baseline == 0 & `Dichotomous Outcome` == 0),
    fn = sum(pred_baseline == 0 & `Dichotomous Outcome` == 1),
    .groups = "drop"
  ) %>%
  mutate(
    sensitivity = tp / (tp + fn),
    specificity = tn / (tn + fp),
    accuracy    = (tp + tn) / n_total,
    over_triage_rate = fp / n_total,    # share over-triaged to ICU
    under_triage_rate = fn / n_total    # share under-triaged
  )

cat("\\textbf{Per-sex confusion matrix and rates (unmodified IRS, threshold $>$ 6):}\\\\\n\n")

display_baseline <- baseline_by_sex %>%
  mutate(
    Sex = ifelse(Gender == "F", "Female", "Male"),
    `n total`    = n_total,
    `Actual ICU` = n_icu_actual,
    `Actual non-ICU` = n_non_actual,
    Sensitivity = sprintf("%.0f%% (%d/%d)", 100*sensitivity, tp, tp+fn),
    Specificity = sprintf("%.0f%% (%d/%d)", 100*specificity, tn, tn+fp),
    Accuracy    = sprintf("%.0f%%", 100*accuracy),
    `Over-triaged` = sprintf("%d (%.0f%%)", fp, 100*over_triage_rate),
    `Under-triaged` = sprintf("%d (%.0f%%)", fn, 100*under_triage_rate)
  ) %>%
  select(Sex, `n total`, `Actual ICU`, `Actual non-ICU`,
         Sensitivity, Specificity, Accuracy,
         `Over-triaged`, `Under-triaged`)

kbl(display_baseline, booktabs = TRUE) %>%
  kable_styling(latex_options = c("hold_position", "scale_down"),
                full_width = FALSE, position = "left") %>%
  print()
cat("\n\\vspace{8pt}\n\n")

# Headline interpretation
female_row <- baseline_by_sex %>% filter(Gender == "F")
male_row   <- baseline_by_sex %>% filter(Gender == "M")

cat("\\textbf{Key observations:}\\\\\n")
cat(sprintf(
  "\\quad Female accuracy: %.0f\\%% \u2014 over-triaged %d patients (%.0f\\%%), under-triaged %d (%.0f\\%%)\\\\\n",
  100 * female_row$accuracy,
  female_row$fp, 100 * female_row$over_triage_rate,
  female_row$fn, 100 * female_row$under_triage_rate
))
cat(sprintf(
  "\\quad Male accuracy: %.0f\\%% \u2014 over-triaged %d patients (%.0f\\%%), under-triaged %d (%.0f\\%%)\\\\\n",
  100 * male_row$accuracy,
  male_row$fp, 100 * male_row$over_triage_rate,
  male_row$fn, 100 * male_row$under_triage_rate
))
cat("\n")

# Chi-squared test for whether the error pattern differs by sex
err_table <- model_data %>%
  mutate(
    pred = ifelse(`INTOXICATE SCORE` > 6, 1, 0),
    error_type = case_when(
      pred == 1 & `Dichotomous Outcome` == 0 ~ "FP (over-triage)",
      pred == 0 & `Dichotomous Outcome` == 1 ~ "FN (under-triage)",
      TRUE ~ "Correct"
    )
  ) %>%
  count(Gender, error_type) %>%
  pivot_wider(names_from = error_type, values_from = n, values_fill = 0)

cat("\\textbf{Error breakdown:}\\\\\n\n")
kbl(err_table, booktabs = TRUE) %>%
  kable_styling(latex_options = "hold_position",
                full_width = FALSE, position = "left") %>%
  print()
cat("\n\n")
```

