# ============================================================================
# CONSTRAINED OPTIMIZATION
# Clinical safety constraint: moving a patient from ICU → non-ICU when the
# toxicologist said ICU is the worst possible error. We require zero such
# errors. Among adjustments satisfying this constraint, find the one that
# maximizes correct reclassifications.
# ============================================================================

cat("\\vspace{12pt}\n\n")
cat("\\textbf{Constrained optimization: zero incorrect ICU $\\rightarrow$ Non-ICU downgrades allowed}\\\\\n\n")
cat("\\textit{Incorrectly downgrading a patient from ICU to non-ICU (model says ICU, toxicologist says ICU, but our adjustment clears them) is the worst clinical error. We filter to adjustments where this never happens, then rank by most correct reclassifications.}\\\\\n\n")

# Recompute directional change counts: separate upgrades from downgrades
sweep_constrained <- sweep_grid
sweep_constrained$n_incorrect_downgrade <- NA_integer_
sweep_constrained$n_correct_downgrade   <- NA_integer_
sweep_constrained$n_correct_upgrade     <- NA_integer_
sweep_constrained$n_incorrect_upgrade   <- NA_integer_

for (i in seq_len(nrow(sweep_grid))) {
  m_adj     <- sweep_grid$male_adj[i]
  f_adj     <- sweep_grid$female_adj[i]
  adj_score <- ifelse(gender == "M", scores + m_adj, scores + f_adj)
  pred_new  <- ifelse(adj_score > 6, 1, 0)

  downgraded <- pred_baseline == 1 & pred_new == 0
  upgraded   <- pred_baseline == 0 & pred_new == 1

  sweep_constrained$n_correct_downgrade[i]   <- sum(downgraded & actual == 0)
  sweep_constrained$n_incorrect_downgrade[i] <- sum(downgraded & actual == 1)
  sweep_constrained$n_correct_upgrade[i]     <- sum(upgraded   & actual == 1)
  sweep_constrained$n_incorrect_upgrade[i]   <- sum(upgraded   & actual == 0)
}

# Merge with sweep_results for kappa/sens/spec
sweep_constrained <- sweep_constrained %>%
  left_join(sweep_results %>% select(male_adj, female_adj,
                                      kappa, sensitivity, specificity,
                                      net_correct, n_correct_chg,
                                      n_incorrect_chg),
            by = c("male_adj", "female_adj")) %>%
  mutate(n_total_correct = n_correct_downgrade + n_correct_upgrade,
         n_total_incorrect = n_incorrect_downgrade + n_incorrect_upgrade)

# Apply safety constraint
safe_adjustments <- sweep_constrained %>%
  filter(n_incorrect_downgrade == 0,
         n_total_correct > 0) %>%
  arrange(desc(n_total_correct), desc(kappa))

if (nrow(safe_adjustments) == 0) {
  cat("\\textit{No adjustment makes any positive changes without also making incorrect downgrades.}\\\\\n")
} else {
  top_safe <- safe_adjustments %>%
    head(10) %>%
    mutate(
      Male     = sprintf("%+0.1f", male_adj),
      Female   = sprintf("%+0.1f", female_adj),
      Sens     = sprintf("%.0f%%", 100 * sensitivity),
      Spec     = sprintf("%.0f%%", 100 * specificity),
      Kappa    = sprintf("%.3f", kappa),
      `Correct clears` = n_correct_downgrade,
      `Correct flags`  = n_correct_upgrade,
      `Bad downgrades` = n_incorrect_downgrade,
      `Bad upgrades`   = n_incorrect_upgrade,
      `Net`            = n_total_correct - n_total_incorrect
    ) %>%
    select(Male, Female, Sens, Spec, Kappa,
           `Correct clears`, `Correct flags`,
           `Bad downgrades`, `Bad upgrades`, Net)

  kbl(top_safe, booktabs = TRUE, align = "c") %>%
    kable_styling(latex_options = c("hold_position", "scale_down"),
                  full_width = FALSE, position = "left") %>%
    print()
  cat("\n")

  best_safe <- safe_adjustments %>% head(1)
  cat(sprintf(
    "\\textbf{Best safe adjustment:} male = %+0.1f, female = %+0.1f | %d correct reclassifications | 0 unsafe downgrades | kappa = %.3f | sens = %.0f%% | spec = %.0f%%\\\\\n\n",
    best_safe$male_adj, best_safe$female_adj,
    best_safe$n_total_correct,
    best_safe$kappa,
    100 * best_safe$sensitivity,
    100 * best_safe$specificity
  ))
