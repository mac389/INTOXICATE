\noindent\textbf{\large Clinical Characterization of Changed-Prediction Patients}

\noindent\textit{For the 24 patients whose prediction changed when biological sex was added: pull the clinical features to see if the 6 ``correct'' changes look different from the 18 ``incorrect'' ones. If they do, that's the figure. If they don't, the +3 adjustment is too blunt and we have a different conversation to have with Mike.}

\vspace{6pt}

```{r clinical_characterization, results='asis'}
# ============================================================================
# CLINICAL FEATURES of the changed-prediction subgroup
#
# Pull every clinical variable that's plausibly in the registry and join it
# to the changed-prediction patients. Compare the "correct" changes to the
# "incorrect" changes to see if there's a clinical signature that
# distinguishes them.
# ============================================================================

# Detect which clinical columns actually exist in the data so this works
# even if column names have drifted slightly. We try a generous set of
# candidates and keep whichever the registry has.
candidate_cols <- c("Age", "Pulse", "SBP", "GCS",
                    "Respiratory Insufficiency", "Cirrhosis",
                    "Dysrhythmia", "Temperature", "RR",
                    "Respiratory Rate", "Heart Rate",
                    "Systolic BP", "Mental Status")

available_cols <- intersect(candidate_cols, names(data))

cat("\\textbf{Clinical columns found in registry:}\\\\\n")
cat(paste(available_cols, collapse = ", "))
cat("\n\n\\vspace{6pt}\n\n")

# Pull the clinical features for the changed-prediction patients
clinical_data <- pred_compare %>%
  filter(pred_changed) %>%
  left_join(
    data %>% select(row_id, any_of(available_cols)),
    by = "row_id",
    suffix = c("", ".raw")
  ) %>%
  arrange(desc(change_correct), `Exposure Category`, `INTOXICATE SCORE`)

# Note: pred_compare already has Age (it inherits from model_data → clean_data).
# The join may have created Age.raw if Age was in available_cols. Use the
# pred_compare Age (already numeric).

# --- Patient-level table with clinical features ---
cat("\\textbf{Patient-level detail with clinical features:}\\\\\n\n")

# Build display: Sex, Exp, IRS, then Age (if present), then other clinical
# columns, then Old/New, Tox, Match
extra_clinical_cols <- setdiff(available_cols, "Age")

display_clinical <- clinical_data %>%
  mutate(
    `Old/New` = sprintf("%s -> %s",
                        ifelse(pred_old == 1, "ICU", "Non"),
                        ifelse(pred_new == 1, "ICU", "Non")),
    `Tox` = ifelse(`Dichotomous Outcome` == 1, "ICU", "Non"),
    Match = ifelse(change_correct == "Correct change", "YES", "no")
  )

if ("Age" %in% available_cols) {
  display_clinical <- display_clinical %>%
    select(Sex = Gender,
           Exp = `Exposure Category`,
           IRS = `INTOXICATE SCORE`,
           Age,
           any_of(extra_clinical_cols),
           `Old/New`, Tox, Match)
} else {
  display_clinical <- display_clinical %>%
    select(Sex = Gender,
           Exp = `Exposure Category`,
           IRS = `INTOXICATE SCORE`,
           any_of(extra_clinical_cols),
           `Old/New`, Tox, Match)
}

# Shorten long column names for readability in the printed table
names(display_clinical) <- gsub("Respiratory Insufficiency", "RespIns",
                                names(display_clinical))
names(display_clinical) <- gsub("Dysrhythmia", "Dysrhy",
                                names(display_clinical))
names(display_clinical) <- gsub("Cirrhosis", "Cirr",
                                names(display_clinical))
names(display_clinical) <- gsub("Temperature", "Temp",
                                names(display_clinical))
names(display_clinical) <- gsub("Mental Status", "MS",
                                names(display_clinical))

kbl(display_clinical, booktabs = TRUE) %>%
  kable_styling(latex_options = c("hold_position", "scale_down"),
                full_width = FALSE, position = "left") %>%
  print()

cat("\n\\vspace{12pt}\n\n")

# --- Summary statistics: correct vs. incorrect changes ---
cat("\\textbf{Summary: do the 6 ``correct'' changes look different from the 18 ``incorrect'' ones?}\\\\\n\n")

# Continuous variables — compare medians and IQRs
continuous_cols <- intersect(c("Age", "Pulse", "SBP", "GCS",
                                "Temperature", "RR", "Respiratory Rate",
                                "Heart Rate", "Systolic BP"),
                              available_cols)

if (length(continuous_cols) > 0) {
  summary_continuous <- clinical_data %>%
    select(change_correct, all_of(continuous_cols)) %>%
    # Coerce all continuous columns to numeric BEFORE pivoting, so they
    # share a type. Excel often stores numbers as character.
    mutate(across(all_of(continuous_cols),
                  ~ suppressWarnings(as.numeric(as.character(.))))) %>%
    pivot_longer(cols = -change_correct,
                 names_to = "variable",
                 values_to = "value") %>%
    filter(!is.na(value)) %>%
    group_by(variable, change_correct) %>%
    summarise(
      n      = n(),
      med    = median(value),
      q1     = quantile(value, 0.25),
      q3     = quantile(value, 0.75),
      .groups = "drop"
    ) %>%
    mutate(summary = sprintf("%.0f [%.0f-%.0f] (n=%d)",
                              med, q1, q3, n)) %>%
    select(variable, change_correct, summary) %>%
    pivot_wider(names_from = change_correct, values_from = summary)

  cat("\\textit{Continuous variables (median [IQR] (n)):}\\\\\n\n")
  kbl(summary_continuous, booktabs = TRUE) %>%
    kable_styling(latex_options = "hold_position",
                  full_width = FALSE, position = "left") %>%
    print()
  cat("\n\n")
}

# Binary variables — compare proportions
binary_cols <- intersect(c("Respiratory Insufficiency", "Cirrhosis",
                           "Dysrhythmia"),
                         available_cols)

if (length(binary_cols) > 0) {
  binary_summary <- clinical_data %>%
    select(change_correct, all_of(binary_cols)) %>%
    # Coerce all binary columns to character so pivot_longer doesn't
    # complain about mixed numeric/character types.
    mutate(across(all_of(binary_cols), as.character)) %>%
    pivot_longer(cols = -change_correct,
                 names_to = "variable",
                 values_to = "value") %>%
    mutate(present = case_when(
      is.na(value) | value == "NA" ~ NA_real_,
      value %in% c("1", "Yes", "yes", "Y", "y", "TRUE", "True") ~ 1,
      TRUE ~ 0
    )) %>%
    filter(!is.na(present)) %>%
    group_by(variable, change_correct) %>%
    summarise(
      n_total   = n(),
      n_present = sum(present),
      pct       = round(100 * n_present / n_total),
      .groups   = "drop"
    ) %>%
    mutate(summary = sprintf("%d/%d (%d%%)", n_present, n_total, pct)) %>%
    select(variable, change_correct, summary) %>%
    pivot_wider(names_from = change_correct, values_from = summary)

