\noindent\textbf{\large Per-Patient Prediction Comparison (Old vs. New Model)}

\noindent\textit{This is the data Mike asked for: for each patient, compare predictions from the IRS-only model vs. the IRS + biological sex model. Patients whose predictions change are the answer — they're the ones the new model captures.}

\vspace{6pt}

```{r prediction_comparison, results='asis'}
# ============================================================================
# PREDICTION COMPARISON — for each patient with complete IRS data, compute:
#   - prediction from old model: IRS > 6 → ICU
#   - prediction from new model: (IRS + 3 if male) > 6 → ICU
#   - prediction_changed: TRUE if the two predictions differ
#   - direction of change: "Newly flagged ICU" or "Newly cleared"
#   - was the toxicologist's actual decision ICU or not?
# Then identify the subgroup whose predictions changed and characterize it.
# ============================================================================

library(knitr)
library(kableExtra)

pred_compare <- model_data %>%
  mutate(
    pred_old = ifelse(`INTOXICATE SCORE` > 6, 1, 0),
    pred_new = ifelse(
      ifelse(Gender == "M", `INTOXICATE SCORE` + 3, `INTOXICATE SCORE`) > 6,
      1, 0
    ),
    pred_changed = pred_old != pred_new,
    change_direction = case_when(
      pred_old == 0 & pred_new == 1 ~ "Newly flagged ICU",
      pred_old == 1 & pred_new == 0 ~ "Newly cleared",
      TRUE ~ "No change"
    ),
    actual_icu = `Dichotomous Outcome` == 1,
    # Was the change "correct" in the sense that it agreed with the
    # toxicologist's actual recommendation?
    change_correct = case_when(
      pred_changed & pred_new == `Dichotomous Outcome` ~ "Correct change",
      pred_changed & pred_new != `Dichotomous Outcome` ~ "Incorrect change",
      TRUE ~ "No change"
    )
  )

n_changed <- sum(pred_compare$pred_changed)
n_changed_correct <- sum(pred_compare$change_correct == "Correct change")
n_changed_incorrect <- sum(pred_compare$change_correct == "Incorrect change")
n_newly_flagged <- sum(pred_compare$change_direction == "Newly flagged ICU")
n_newly_cleared <- sum(pred_compare$change_direction == "Newly cleared")

# --- Headline counts ---
cat("\\textbf{Headline counts:}\\\\\n")
cat(sprintf("Total patients in model: %d\\\\\n", n_model))
cat(sprintf("Predictions that changed (old vs new): %d (%.0f\\%%)\\\\\n",
            n_changed, 100 * n_changed / n_model))
cat(sprintf("\\quad Newly flagged for ICU (raised by sex adjustment): %d\\\\\n",
            n_newly_flagged))
cat(sprintf("\\quad Newly cleared (lowered by sex adjustment): %d\\\\\n",
            n_newly_cleared))
cat(sprintf("Of changes that occurred, agreement with toxicologist:\\\\\n"))
cat(sprintf("\\quad Correct changes (agree with actual disposition): %d\\\\\n",
            n_changed_correct))
cat(sprintf("\\quad Incorrect changes (disagree with actual disposition): %d\\\\\n",
            n_changed_incorrect))
cat("\n\\vspace{8pt}\n\n")

# --- 2x2 confusion: old prediction vs new prediction ---
cat("\\textbf{Old vs. new model agreement (2 \\(\\times\\) 2):}\\\\\n\n")
confusion_old_new <- pred_compare %>%
  count(pred_old, pred_new) %>%
  mutate(pred_old = factor(pred_old, levels = c(0, 1),
                            labels = c("Old: Non-ICU", "Old: ICU")),
         pred_new = factor(pred_new, levels = c(0, 1),
                            labels = c("New: Non-ICU", "New: ICU"))) %>%
  pivot_wider(names_from = pred_new, values_from = n, values_fill = 0)

kbl(confusion_old_new, booktabs = TRUE, align = c("l", "r", "r")) %>%
  kable_styling(latex_options = "hold_position",
                full_width = FALSE, position = "left") %>%
  print()

cat("\n\\vspace{8pt}\n\n")

# --- Characterize the changed-prediction subgroup ---
changed_subgroup <- pred_compare %>%
  filter(pred_changed)

if (nrow(changed_subgroup) > 0) {
  cat("\\textbf{Characteristics of patients whose prediction changed:}\\\\\n\n")

  # By sex
  by_sex <- changed_subgroup %>% count(Gender, change_direction)
  cat("\\textit{By biological sex:}\\\\\n")
  for (i in seq_len(nrow(by_sex))) {
    cat(sprintf("\\quad %s: %d (%s)\\\\\n",
                by_sex$Gender[i], by_sex$n[i], by_sex$change_direction[i]))
  }
  cat("\n")

  # By exposure category
  by_exposure <- changed_subgroup %>%
    count(`Exposure Category`, change_direction) %>%
    arrange(desc(n))
  cat("\\textit{By exposure category:}\\\\\n")
  for (i in seq_len(nrow(by_exposure))) {
    cat(sprintf("\\quad %s: %d (%s)\\\\\n",
                by_exposure$`Exposure Category`[i],
                by_exposure$n[i],
                by_exposure$change_direction[i]))
  }
  cat("\n")

  # By actual disposition (was the change correct?)
  by_outcome <- changed_subgroup %>%
    count(change_correct, change_direction)
  cat("\\textit{By correctness of change:}\\\\\n")
  for (i in seq_len(nrow(by_outcome))) {
    cat(sprintf("\\quad %s, %s: %d\\\\\n",
                by_outcome$change_correct[i],
                by_outcome$change_direction[i],
                by_outcome$n[i]))
  }
  cat("\n\\vspace{8pt}\n\n")

  # --- Patient-level table for the changed subgroup ---
  cat("\\textbf{Patient-level detail for changed predictions:}\\\\\n\n")
  patient_table <- changed_subgroup %>%
    select(Gender, `Exposure Category`, `INTOXICATE SCORE`,
           pred_old, pred_new, `Dichotomous Outcome`, change_correct) %>%
    mutate(
      `Old pred` = ifelse(pred_old == 1, "ICU", "Non-ICU"),
      `New pred` = ifelse(pred_new == 1, "ICU", "Non-ICU"),
      `Tox actual` = ifelse(`Dichotomous Outcome` == 1, "ICU", "Non-ICU"),
      Correct = ifelse(change_correct == "Correct change", "Yes", "No")
    ) %>%
    select(Sex = Gender,
           Exposure = `Exposure Category`,
           IRS = `INTOXICATE SCORE`,
           `Old pred`, `New pred`, `Tox actual`, Correct) %>%
    arrange(desc(Correct), Exposure, IRS)

  kbl(patient_table, booktabs = TRUE,
      align = c("l", "l", "r", "l", "l", "l", "l")) %>%
    kable_styling(latex_options = c("hold_position", "scale_down"),
                  full_width = FALSE, position = "left") %>%
    print()
}

# --- Cohen's kappa ---
cat("\n\\vspace{8pt}\n\n")
cat("\\textbf{Inter-rater agreement (toxicologist vs. model) -- Cohen's kappa:}\\\\\n\n")

if (requireNamespace("psych", quietly = TRUE)) {
  kappa_old <- psych::cohen.kappa(
    cbind(pred_compare$pred_old, pred_compare$`Dichotomous Outcome`)
  )
  kappa_new <- psych::cohen.kappa(
    cbind(pred_compare$pred_new, pred_compare$`Dichotomous Outcome`)
  )

  cat(sprintf("Old model (IRS only): kappa = %.3f (95%% CI %.3f-%.3f)\\\\\n",
              kappa_old$kappa,
              kappa_old$confid["unweighted kappa", "lower"],
              kappa_old$confid["unweighted kappa", "upper"]))
  cat(sprintf("New model (IRS + sex): kappa = %.3f (95%% CI %.3f-%.3f)\\\\\n",
              kappa_new$kappa,
              kappa_new$confid["unweighted kappa", "lower"],
              kappa_new$confid["unweighted kappa", "upper"]))
  cat(sprintf("Delta: %+.3f\\\\\n",
              kappa_new$kappa - kappa_old$kappa))
} else {
  cat("\\textit{Install the \\texttt{psych} package to compute Cohen's kappa: \\texttt{install.packages(\"psych\")}}\\\\\n")
}
```

