  mutate(
    pred_old = ifelse(`INTOXICATE SCORE` > 6, 1, 0),
    pred_new = ifelse(
      ifelse(Gender == "M",
             `INTOXICATE SCORE` + optimal_male,
             `INTOXICATE SCORE` + optimal_female) > 6,
      1, 0
    ),
    pred_changed = pred_old != pred_new,
    change_direction = case_when(
      pred_old == 0 & pred_new == 1 ~ "Newly flagged ICU",
      pred_old == 1 & pred_new == 0 ~ "Newly cleared",
      TRUE ~ "No change"
    ),
    change_correct = case_when(
      pred_changed & pred_new == `Dichotomous Outcome` ~ "Correct change",
      pred_changed & pred_new != `Dichotomous Outcome` ~ "Incorrect change",
      TRUE ~ "No change"
    )
  )

# Headline counts under the optimal adjustment
n_changed_opt   <- sum(opt_pred_compare$pred_changed)
n_correct_opt   <- sum(opt_pred_compare$change_correct == "Correct change")
n_incorrect_opt <- sum(opt_pred_compare$change_correct == "Incorrect change")
n_cleared_opt   <- sum(opt_pred_compare$change_direction == "Newly cleared")
n_flagged_opt   <- sum(opt_pred_compare$change_direction == "Newly flagged ICU")

