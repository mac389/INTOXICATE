\noindent\textbf{\large Stress Test: Sweeping Male and Female Adjustments}

\noindent\textit{The current +3 male adjustment was scaled heuristically from the regression coefficient \u2014 not optimized. This sweeps adjustments from 0 to +5 for males and \u22125 to 0 for females (in 0.5 increments) and evaluates each combination against four metrics: Cohen's kappa, sensitivity, specificity, and net correct changes (correct minus incorrect prediction changes). Threshold remains IRS > 6.}

\vspace{6pt}

```{r adjustment_sweep, results='asis'}
# ============================================================================
# STRESS TEST — sweep male and female adjustments and score each combination
# against multiple metrics. Goal: find the adjustment(s) that maximize
# agreement with toxicologist disposition.
# ============================================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(knitr)
library(kableExtra)

# Search grid: males 0 to +5, females -20 to 0, both in 0.5 increments.
# Female range extended to -20 to test whether kappa keeps climbing
# (suggesting the adjustment is just removing females from the model)
# or peaks and drops (suggesting a real biological optimum).
male_adj_grid   <- seq(0, 5, by = 0.5)
female_adj_grid <- seq(-20, 0, by = 0.5)

# Store toxicologist actuals once
actual <- model_data$`Dichotomous Outcome`
scores <- model_data$`INTOXICATE SCORE`
gender <- model_data$Gender
n_pos  <- sum(actual == 1)  # actual ICU patients
n_neg  <- sum(actual == 0)  # actual non-ICU patients

# Baseline (no adjustment) for delta computations
pred_baseline <- ifelse(scores > 6, 1, 0)
sens_baseline <- sum(pred_baseline == 1 & actual == 1) / n_pos
spec_baseline <- sum(pred_baseline == 0 & actual == 0) / n_neg

# Cohen's kappa as a function of two binary vectors (no external dep needed)
cohen_kappa <- function(pred, truth) {
  tab <- table(factor(pred,  levels = c(0, 1)),
               factor(truth, levels = c(0, 1)))
  n   <- sum(tab)
  po  <- sum(diag(tab)) / n
  pe  <- sum(rowSums(tab) * colSums(tab)) / n^2
  if (pe == 1) return(NA_real_)
  (po - pe) / (1 - pe)
}

# Score every (male_adj, female_adj) pair using an explicit loop.
# We avoid rowwise() because it changes the scope so that vectors from the
# outer environment (like `actual` and `gender`) get treated as length-1
# within each row's scope, breaking table() in cohen_kappa().
sweep_grid <- expand.grid(
  male_adj   = male_adj_grid,
  female_adj = female_adj_grid
)

sweep_results <- sweep_grid
sweep_results$n_changed       <- NA_integer_
sweep_results$n_correct_chg   <- NA_integer_
sweep_results$n_incorrect_chg <- NA_integer_
sweep_results$net_correct     <- NA_integer_
sweep_results$sensitivity     <- NA_real_
sweep_results$specificity     <- NA_real_
sweep_results$kappa           <- NA_real_

for (i in seq_len(nrow(sweep_grid))) {
  m_adj <- sweep_grid$male_adj[i]
  f_adj <- sweep_grid$female_adj[i]
  adj_score <- ifelse(gender == "M",
                       scores + m_adj,
                       scores + f_adj)
  pred <- ifelse(adj_score > 6, 1, 0)

  sweep_results$n_changed[i]       <- sum(pred != pred_baseline)
  sweep_results$n_correct_chg[i]   <- sum(pred != pred_baseline &
                                           pred == actual)
  sweep_results$n_incorrect_chg[i] <- sum(pred != pred_baseline &
                                           pred != actual)
  sweep_results$net_correct[i]     <-
    sweep_results$n_correct_chg[i] - sweep_results$n_incorrect_chg[i]
  sweep_results$sensitivity[i] <- sum(pred == 1 & actual == 1) / n_pos
  sweep_results$specificity[i] <- sum(pred == 0 & actual == 0) / n_neg
  sweep_results$kappa[i]       <- cohen_kappa(pred, actual)
}

sweep_results <- sweep_results %>%
  mutate(
    sens_delta = sensitivity - sens_baseline,
    spec_delta = specificity - spec_baseline
  )

# --- Top performers across each metric ---
cat("\\textbf{Top performers across each metric}\\\\\n")
cat("\\textit{(Bolded row in each table is the current default of male=+3, female=0)}\\\\\n\n")

format_top <- function(df, metric_col, n = 5, decreasing = TRUE) {
  df %>%
    arrange(if (decreasing) desc(.data[[metric_col]]) else .data[[metric_col]]) %>%
    head(n) %>%
    mutate(
      Male       = sprintf("%+0.1f", male_adj),
      Female     = sprintf("%+0.1f", female_adj),
      Sens       = sprintf("%.0f%%", 100 * sensitivity),
      Spec       = sprintf("%.0f%%", 100 * specificity),
      Kappa      = sprintf("%.3f", kappa),
      Correct    = n_correct_chg,
      Incorrect  = n_incorrect_chg,
      Net        = net_correct
    ) %>%
    select(Male, Female, Sens, Spec, Kappa, Correct, Incorrect, Net)
}

cat("\\textbf{1. Highest Cohen's kappa (overall agreement):}\\\\\n\n")
kbl(format_top(sweep_results, "kappa"),
    booktabs = TRUE, align = "c") %>%
  kable_styling(latex_options = "hold_position",
