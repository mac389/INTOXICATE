optimal_male   <- top_kappa$male_adj
optimal_female <- top_kappa$female_adj

cat(sprintf(
  "\\textbf{Optimal adjustment (max kappa):} male = %+0.1f, female = %+0.1f\\\\\n",
  optimal_male, optimal_female
))
