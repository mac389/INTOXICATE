# ============================================================================
# REFERENCE TABLE — Exposure Category by Gender, with everything outside
# the 8 valid categories rolled into "Other" so we can see how big the
# residual bucket is. Not for the poster, just a sanity check.
# ============================================================================

library(knitr)
library(kableExtra)

# Re-read raw data (without the valid-category filter applied earlier)
# so we can see what's in the "Other" bucket.
raw_table <- data %>%
  filter(!is.na(Gender), !is.na(`Exposure Category`)) %>%
  mutate(
    Gender = trimws(Gender),
    `Exposure Category` = trimws(`Exposure Category`),
    Age = as.numeric(Age)
  ) %>%
  filter(Gender %in% c("M", "F"),
         !is.na(Age), Age >= 12) %>%
  mutate(
    cat_grouped = ifelse(`Exposure Category` %in% valid_categories,
                         `Exposure Category`,
                         "Other")
  )

# What's actually in the "Other" bucket — print for transparency
other_categories <- raw_table %>%
  filter(cat_grouped == "Other") %>%
  count(`Exposure Category`, sort = TRUE)

# Build the table: counts and row percentages by gender
ref_table <- raw_table %>%
  count(cat_grouped, Gender) %>%
  pivot_wider(names_from = Gender, values_from = n, values_fill = 0) %>%
  mutate(Total = F + M) %>%
  mutate(
    F_lab = sprintf("%d (%d%%)", F, round(100 * F / Total)),
    M_lab = sprintf("%d (%d%%)", M, round(100 * M / Total))
  ) %>%
  arrange(desc(Total))

# Order: 8 valid categories (descending count), then Other, then Unknown last
# matches the reference table format you shared
top_order <- ref_table %>%
  filter(cat_grouped %in% valid_categories,
         cat_grouped != "Unknown") %>%
  arrange(desc(Total)) %>%
  pull(cat_grouped)

bottom_order <- ref_table %>%
  filter(cat_grouped %in% c("Sedatives", "Alcohol", "Other", "Unknown")) %>%
  pull(cat_grouped) %>%
  intersect(c("Sedatives", "Alcohol", "Other", "Unknown"))

# Assemble in target order
ordered_cats <- c(setdiff(top_order,
                          c("Sedatives", "Alcohol", "Unknown")),
                  bottom_order)

ref_table <- ref_table %>%
  mutate(cat_grouped = factor(cat_grouped, levels = ordered_cats)) %>%
  arrange(cat_grouped)

# Total row
totals <- ref_table %>%
  summarise(F = sum(F), M = sum(M), Total = sum(Total)) %>%
  mutate(
    cat_grouped = "Total",
    F_lab = sprintf("%d (%d%%)", F, round(100 * F / Total)),
    M_lab = sprintf("%d (%d%%)", M, round(100 * M / Total))
  )

# Chi-squared on the displayed table (same grouping)
chi_table <- table(raw_table$cat_grouped, raw_table$Gender)
chi_p_grouped <- suppressWarnings(chisq.test(chi_table))$p.value

# Render
display_df <- bind_rows(
  ref_table %>% select(cat_grouped, F_lab, M_lab, Total),
