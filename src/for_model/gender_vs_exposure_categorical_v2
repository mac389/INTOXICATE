# FIGURE 3: Proportions - ordered by decreasing male percentage  
fig3_order <- c("Antidepressants", "Analgesic", "Sedatives", "Combination", "Street Drugs", "CO, As, CN", "Alcohol")

p3 <- ggplot(fig2_data, aes(x = factor(`Exposure Category`, levels = fig3_order), 
                           y = prop, fill = Gender)) +
  geom_bar(stat = "identity", position = "fill", width = 0.75) +
  coord_flip() +
  scale_y_continuous(labels = percent_format(accuracy = 1), expand = c(0, 0)) +
  scale_fill_manual(values = c("F" = "black", "M" = "grey70")) +
