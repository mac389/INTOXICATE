# ===== Libraries =====
library(dplyr)
library(ggplot2)
library(readxl)
library(knitr)
library(kableExtra)
library(scales)

# ===== Load & Clean Data =====
data <- read_excel("~/Downloads/Tox Book.v2.xlsx", sheet = "INTOXICATE")

# Clean and filter to only the 7 main categories we want
clean_data <- data %>%
  filter(!is.na(Gender), !is.na(`Exposure Category`)) %>%
  mutate(Gender = trimws(Gender),
         `Exposure Category` = trimws(`Exposure Category`)) %>%
  filter(Gender %in% c("M", "F")) %>%
  # Only keep the 7 main categories - exclude Other and Unknown completely
  filter(`Exposure Category` %in% c("Combination", "Analgesic", "Antidepressants", 
                                   "Street Drugs", "CO, As, CN", "Sedatives", "Alcohol"))

# Order categories by total count for tables
category_counts <- clean_data %>%
  count(`Exposure Category`) %>%
  arrange(desc(n))

ordered_categories <- category_counts$`Exposure Category`

# Create factor with proper ordering for tables
clean_data$`Exposure Category` <- factor(clean_data$`Exposure Category`, 
                                        levels = ordered_categories)

# ===== Create Tables =====
# Create contingency table
cont_table <- table(clean_data$`Exposure Category`, clean_data$Gender)

# Statistical tests
fisher_result <- fisher.test(cont_table)
fisher_p_value <- ifelse(fisher_result$p.value < 0.001, "< 0.001", 
                        format(round(fisher_result$p.value, 3), nsmall = 3))

chi_result <- suppressWarnings(chisq.test(cont_table))
chi_p_value <- ifelse(chi_result$p.value < 0.001, "< 0.001", 
                     format(round(chi_result$p.value, 3), nsmall = 3))

overall_significant <- fisher_result$p.value < 0.05
significance_text <- ifelse(overall_significant, "significant", "no significant")

# Create summary table
create_summary_table <- function(cont_table) {
  df <- as.data.frame.matrix(cont_table)
  df$Total <- df$F + df$M
  df$F_pct <- round(100*df$F/df$Total)
  df$M_pct <- round(100*df$M/df$Total)
  df$F <- paste0(df$F," (",df$F_pct,"%)")
  df$M <- paste0(df$M," (",df$M_pct,"%)")
  df$Total <- as.character(df$Total)
  result_df <- df[,c("F","M","Total")]
  total_f <- sum(cont_table[,"F"])
  total_m <- sum(cont_table[,"M"])
  grand_total <- total_f + total_m
  totals_row <- data.frame(
    F=paste0(total_f," (",round(100*total_f/grand_total),"%)"),
    M=paste0(total_m," (",round(100*total_m/grand_total),"%)"),
    Total=as.character(grand_total)
  )
  rownames(totals_row) <- "Total"
  rbind(result_df, totals_row)
}

summary_table <- create_summary_table(cont_table)

# Display Table 1
cat("**Table 1. Exposure Category by Gender**\n\n")
kable(summary_table, booktabs=TRUE, align=c("c","c","c")) %>%
  kable_styling(latex_options=c("striped","hold_position"), position="center") %>%
  add_header_above(c(" " = 1, "Gender" = 2, " " = 1)) %>%
  row_spec(nrow(summary_table), bold=TRUE) %>%
  print()
cat("\n**Table 1.** Counts and row-wise percentages for each exposure category by gender, including totals. Percentages in the F and M columns reflect the proportion within each row. Fisher's exact test found a ",significance_text," association between gender and exposure category (p = ",fisher_p_value,"). Chi-square test yielded similar results (p = ",chi_p_value,"). Categories are ordered by decreasing total count. 'Other' and 'Unknown' categories were removed due to small sample sizes.\n\n", sep="")

# ===== Focused Analyses =====
create_binary_comparison <- function(data, target_category) {
  data %>%
    mutate(category_binary = ifelse(`Exposure Category` == target_category, 
                                   target_category, "All Others"))
}

# Antidepressants comparison
antidep_data <- create_binary_comparison(clean_data, "Antidepressants")
antidep_table <- table(antidep_data$category_binary, antidep_data$Gender)
antidep_fisher <- fisher.test(antidep_table)
antidep_p <- ifelse(antidep_fisher$p.value < 0.001, "< 0.001", 
                   format(round(antidep_fisher$p.value, 3), nsmall = 3))
antidep_significant <- antidep_fisher$p.value < 0.05

# Analgesic comparison  
analgesic_data <- create_binary_comparison(clean_data, "Analgesic")
analgesic_table <- table(analgesic_data$category_binary, analgesic_data$Gender)
analgesic_fisher <- fisher.test(analgesic_table)
analgesic_p <- ifelse(analgesic_fisher$p.value < 0.001, "< 0.001", 
                     format(round(analgesic_fisher$p.value, 3), nsmall = 3))
analgesic_significant <- analgesic_fisher$p.value < 0.05

# Street Drugs comparison
streetdrugs_data <- create_binary_comparison(clean_data, "Street Drugs")
streetdrugs_table <- table(streetdrugs_data$category_binary, streetdrugs_data$Gender)
streetdrugs_fisher <- fisher.test(streetdrugs_table)
streetdrugs_p <- ifelse(streetdrugs_fisher$p.value < 0.001, "< 0.001", 
                       format(round(streetdrugs_fisher$p.value, 3), nsmall = 3))
streetdrugs_significant <- streetdrugs_fisher$p.value < 0.05

# Create focused tables
create_focused_table <- function(table_data) {
  df <- as.data.frame.matrix(table_data)
  df$Total <- df$F + df$M
  df$F_pct <- round(100*df$F/df$Total)
  df$M_pct <- round(100*df$M/df$Total)
  df$F <- paste0(df$F," (",df$F_pct,"%)")
  df$M <- paste0(df$M," (",df$M_pct,"%)")
  df$Total <- as.character(df$Total)
  df[,c("F","M","Total")]
}

antidep_summary <- create_focused_table(antidep_table)
analgesic_summary <- create_focused_table(analgesic_table)
streetdrugs_summary <- create_focused_table(streetdrugs_table)

# Display Table 2
cat("\\pagebreak\n\n")
cat("**Table 2. Focused Comparisons: High-Frequency Categories vs All Others**\n\n")
cat("**Antidepressants vs All Others**\n\n")
kable(antidep_summary, booktabs=TRUE, align=c("c","c","c")) %>%
  kable_styling(latex_options=c("striped","hold_position"), position="center") %>%
  add_header_above(c(" " = 1, "Gender" = 2, " " = 1)) %>%
  print()
cat("\n")
cat("**Analgesic vs All Others**\n\n")
kable(analgesic_summary, booktabs=TRUE, align=c("c","c","c")) %>%
  kable_styling(latex_options=c("striped","hold_position"), position="center") %>%
  add_header_above(c(" " = 1, "Gender" = 2, " " = 1)) %>%
  print()
cat("\n")
cat("**Street Drugs vs All Others**\n\n")
kable(streetdrugs_summary, booktabs=TRUE, align=c("c","c","c")) %>%
  kable_styling(latex_options=c("striped","hold_position"), position="center") %>%
  add_header_above(c(" " = 1, "Gender" = 2, " " = 1)) %>%
  print()
cat("\n**Table 2.** Binary comparisons examining whether high-frequency exposure categories show different gender distributions compared to all other categories combined. Antidepressants vs all others: Fisher's exact test p = ",antidep_p,ifelse(antidep_significant, " (significant)", " (not significant)"),". Analgesic vs all others: Fisher's exact test p = ",analgesic_p,ifelse(analgesic_significant, " (significant)", " (not significant)"),". Street Drugs vs all others: Fisher's exact test p = ",streetdrugs_p,ifelse(streetdrugs_significant, " (significant)", " (not significant)"),".\n\n", sep="")

# ===== FIGURES =====
base_sz <- 11

# FIGURE 1: Raw counts - ordered top to bottom as specified
fig1_order <- c("Alcohol", "Sedatives", "CO, As, CN", "Street Drugs", "Antidepressants", "Analgesic", "Combination")
