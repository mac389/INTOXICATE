# FIGURE 2: Proportions - ordered by decreasing female percentage
fig2_order <- c("Alcohol", "CO, As, CN", "Street Drugs", "Combination", "Sedatives", "Analgesic", "Antidepressants")
fig2_data <- clean_data %>%
  count(`Exposure Category`, Gender) %>%
  group_by(Gender) %>%
  mutate(prop = n/sum(n)) %>%
  ungroup()

p2 <- ggplot(fig2_data, aes(x = factor(`Exposure Category`, levels = fig2_order), 
